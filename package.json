{
  "name": "gainmaps.com",
  "version": "1.0.0",
  "description": "Assign a Rec.2020 PQ ICC profile to JPEG or PNG without touching pixel data",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "test": "vitest run --coverage",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc",
    "build": "tsc",
    "dev": "turbo dev --filter=@gainmaps/web",
    "web:dev": "turbo dev --filter=@gainmaps/web",
    "web:build": "turbo build --filter=@gainmaps/web",
    "lint": "turbo lint",
    "check": "turbo typecheck test",
    "lh": "tsx tools/lighthouse/run.ts both",
    "lh:desktop": "tsx tools/lighthouse/run.ts desktop",
    "lh:mobile": "tsx tools/lighthouse/run.ts mobile"
  },
  "keywords": [
    "hdr",
    "icc",
    "rec2020",
    "jpeg",
    "png",
    "gain-map"
  ],
  "author": "Kirk Strobeck <kirk@strobeck.com>",
  "license": "MIT",
  "repository": "https://github.com/kirkstrobeck/gainmaps.com",
  "type": "module",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jpeg-js": "^0.4.4",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.8",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "homepage": "https://www.gainmaps.com"
}
