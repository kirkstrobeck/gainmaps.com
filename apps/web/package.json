{
  "name": "@gainmaps/web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Kirk Strobeck <kirk@strobeck.com>",
  "repository": "https://github.com/kirkstrobeck/gainmaps.com",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:worker && next dev --hostname 0.0.0.0 --port 3000",
    "build": "pnpm --filter gainmap build && pnpm build:worker && NODE_ENV=production next build",
    "build:worker": "esbuild worker/hdr-service-worker.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=public/hdr-service-worker.js --legal-comments=none",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test smoke.spec.ts --browser chromium --reporter line"
  },
  "dependencies": {
    "@giscus/react": "*",
"@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifuct-js": "^2.1.2",
    "hdrify": "^0.12.1",
    "heic-decode": "^2.1.0",
    "next": "^15.4.5",
    "posthog-js": "^1.418.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "upng-js": "^2.1.0",
    "gainmap": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  },
  "homepage": "https://www.gainmaps.com"
}
